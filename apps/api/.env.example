WINDVEAL_DATABASE_URL=postgres://windveal:windveal@localhost:5433/windveal
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5173
SITE_URL=http://localhost:5174
API_PORT=4000
STORAGE_DIR=./storage

# WindVeal AI: any model server that speaks the standard chat-completions format with tools.
# Leave AI_BASE_URL empty and WindVeal AI shows as "not switched on"; everything else works as normal.
# Trying it on your computer with Ollama (https://ollama.com):
#   1. Install Ollama, then run:  ollama pull qwen3.5:4b
#   2. Give it room for WindVeal's tools: set OLLAMA_CONTEXT_LENGTH=16384 before starting Ollama
#      No graphics card? Built-in graphics (Intel/AMD) are still faster than the processor alone:
#      also set OLLAMA_VULKAN=1 and OLLAMA_IGPU_ENABLE=1, then restart Ollama.
#   3. Fill in these three lines and restart the API:
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen3.5:4b
# AI_EXTRA_BODY={"reasoning_effort": "none"}   (turns off slow "thinking" mode)
# AI_API_KEY=            (only if your model server asks for one)
