# Copy to apps/site/.env to change these. All are optional in development.
VITE_APP_URL=http://localhost:5173
VITE_CONTACT_EMAIL=hello@windveal.com
# The organisation whose careers page "Careers at WindVeal" opens (its slug, shown in Settings).
VITE_COMPANY_CAREERS_SLUG=windveal
# Download links for the apps (installer or store page). Leave empty to show "Coming soon".
VITE_DOWNLOAD_WINDOWS=
VITE_DOWNLOAD_MAC=
VITE_DOWNLOAD_LINUX=
VITE_DOWNLOAD_ANDROID=
VITE_DOWNLOAD_IOS=
